// Generated by matugen -- edit this template, not the output.
{
    "clock": {
        "format": "{:%H:%M}  ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            // Starts on the single-month view
            // on-click-right toggles to the full year grid
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='{{colors.on_surface.default.hex}}'><b>{}</b></span>",
                "days": "<span color='{{colors.on_surface_variant.default.hex}}'>{}</span>",
                "weeks": "<span color='{{colors.outline.default.hex}}'>W{}</span>",
                "weekdays": "<span color='{{colors.tertiary.default.hex}}'><b>{}</b></span>",
                "today": "<span color='{{colors.primary.default.hex}}'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
