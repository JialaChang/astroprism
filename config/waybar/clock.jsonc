// Generated by matugen -- edit this template, not the output.
// The whole clock module lives here: waybar's "include" merges only at the
// top level, so "clock" must be defined in exactly one file.
// Calendar colours are pango markup, so they need literal hex.
{
    "clock": {
        "format": "{:%H:%M}  ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            // Starts on the single-month view; on-click-right toggles to the
            // full year grid (mode-mon-col below only applies to that view).
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#e4e1e9'><b>{}</b></span>",
                "days": "<span color='#c7c5d0'>{}</span>",
                "weeks": "<span color='#918f9a'>W{}</span>",
                "weekdays": "<span color='#e8b9d4'><b>{}</b></span>",
                "today": "<span color='#c0c1ff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
