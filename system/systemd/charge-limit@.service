# Started by system/udev/90-charge-limit.rules for each battery.
[Unit]
Description=Default %i charge limit to 80%% and let wheel change it

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'f=/sys/class/power_supply/%i/charge_control_end_threshold; for _ in $(seq 30); do [ -e "$f" ] && break; sleep 1; done; [ -e "$f" ] || exit 0; echo 80 > "$f"; chgrp wheel "$f"; chmod g+w "$f"'
