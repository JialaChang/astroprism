# Default the max charge to 80% and let wheel change it (waybar battery click).
# Vendor drivers add the threshold after the battery's add event, so a service waits for it.
# Install: sudo cp system/udev/90-charge-limit.rules /etc/udev/rules.d/
#          sudo cp system/systemd/charge-limit@.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo udevadm control --reload
# Apply now: sudo udevadm trigger --action=add -s power_supply
ACTION=="add", SUBSYSTEM=="power_supply", ATTR{type}=="Battery", TAG+="systemd", ENV{SYSTEMD_WANTS}+="charge-limit@%k.service"
