#!/usr/bin/env bash

FILE=$1

if [ -z "$FILE" ]; then
  notify-send "Can not find wallpaper files..."
  exit 1
fi

# Change wallpaper
awww img "$FILE" \
  --transition-type any \
  --transition-duration 1.4 \
  --transition-fps 60 \
  --transition-step 50

MODE_FILE="$HOME/.cache/theme_mode"
MODE=$([ -f "$MODE_FILE" ] && cat "$MODE_FILE" || echo "dark")

matugen image "$FILE" --mode "$MODE" --prefer saturation
echo "$FILE" >~/.cache/last_wallpaper
gsettings set org.gnome.desktop.interface color-scheme "prefer-$MODE"
pkill waybar
setsid -f waybar >/dev/null 2>&1
swaync-client -rs &

notify-send "Wallpaper already change into $(basename "$FILE")"
